{
	"$comment": "Screens and states the axe check visits (tests/e2e/features/accessibility.feature, one example per screen and state). {building} etc. (also in 'queries') are ids of records the check seeds itself. Every new or changed screen is added here; every state must be one of stateMeanings. 'empty' and 'first-use' are covered by DOM tests (see docs/design/offene-punkte.md). Dark mode joins colorSchemes in stage 8 (docs/design/01-plan.md D4). A screen may override the query string of a state in 'queries' (the apartment list ignores ?search=, see docs/design/offene-punkte.md).",
	"stateMeanings": {
		"default": "The page as loaded with the seeded records.",
		"empty": "A list with no records at all. Not producible in the shared E2E database; covered by DOM tests of the empty branch and by 'filtered-empty', which shows the same EmptyState component.",
		"first-use": "Overview without any building. Covered like 'empty' by a DOM test of the first-use branch.",
		"filtered-empty": "A list whose search matches nothing (?search=…).",
		"submit-empty": "A new-record form submitted without input: all validation errors visible.",
		"delete-dialog": "The delete confirmation dialog open.",
		"end-dialog": "The dialog that ends a rental contract open.",
		"send-dialog": "The confirmation before marking a statement as sent open.",
		"reminder-dialog": "The Mahnung dialog of a sent statement open.",
		"mark-paid-dialog": "The dialog that marks a statement as paid open.",
		"action-error": "A server action failed (deleting a sent statement, posted as from a stale tab, is refused): the error alert visible.",
		"every-wizard-step": "Each step of the wizard in turn, up to the step before saving.",
		"preview-empty": "Statement wizard preview for a period without rental contracts.",
		"overlap-warning": "Rental contract wizard with a start date that overlaps another contract of the apartment.",
		"draft-restored": "A wizard reopened with a draft saved in the browser: restore notice and save status visible.",
		"formula-tested": "Distribution key form after testing a formula.",
		"profile-sum-invalid": "Heating profile form whose monthly shares do not add up to 100 %.",
		"login-error": "Login page showing a sign-in error (?error=failed).",
		"mobile-menu-open": "Navigation drawer open (mobile and tablet viewport).",
		"user-menu-open": "User menu in the header open.",
		"dialog-open": "A confirmation dialog of the page open.",
		"busy-dialog-open": "A confirmation dialog open while its action is running."
	},
	"screens": [
		{
			"name": "gallery",
			"path": "/gallery",
			"states": [
				"default",
				"dialog-open",
				"busy-dialog-open"
			]
		},
		{
			"name": "login",
			"path": "/login",
			"public": true,
			"states": [
				"default",
				"login-error"
			]
		},
