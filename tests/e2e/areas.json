{
	"about": "E2E selection on pull requests (#845, tools/ci/e2e-areas.mjs): a pull request whose changed files all belong to areas runs those areas' features plus «always»; any other changed file runs every scenario. «ignore» lists files no scenario runs; «fullRunOnly» names the cross-cutting features that only a full run runs (every feature file is in an area, «always» or «fullRunOnly»). Paths are regular expressions; features are Playwright file filters (regular expressions matched against the generated spec path, without shell characters: they go into the command line unquoted). main and the nightly run run everything.",
	"always": [
		"features/sprachen-bildschirme.feature",
		"features/demo.feature"
	],
	"fullRunOnly": [
		"features/accessibility.feature",
		"features/authentication.feature",
		"features/breadcrumb.feature",
		"features/hydration.feature",
		"features/navigation.feature",
		"features/sprachen.feature"
	],
	"ignore": [
		"(^|/)__tests__/",
		"\\.test\\.ts$",
		"\\.md$",
		"^docs/",
		"^\\.claude/",
		"^tools/(?!ci/e2e-areas\\.mjs$)",
		"^tests/contracts/"
	],
	"areas": {
		"buildings": {
			"paths": [
				"^src/routes/(api/)?buildings/",
				"^src/lib/server/building(-form|-register)?\\.ts$",
				"^backend/src/routes/buildings\\.ts$",
				"^backend/src/services/building(\\.service|-fields)\\.ts$"
			],
			"features": [
				"features/building"
			]
		},
		"apartments": {
			"paths": [
				"^src/routes/(api/)?apartments/",
				"^src/lib/server/apartment(-form)?\\.ts$",
				"^backend/src/routes/apartments\\.ts$",
				"^backend/src/services/apartment\\.service\\.ts$"
			],
			"features": [
				"features/apartment"
			]
		},
		"tenants": {
			"paths": [
				"^src/routes/(api/)?tenants/",
				"^src/lib/server/tenant(-form)?\\.ts$",
				"^backend/src/routes/tenants\\.ts$",
				"^backend/src/services/tenant(\\.service|-fields|-anonymise\\.service|-export\\.service)\\.ts$"
			],
			"features": [
				"features/tenant"
			]
		},
		"contracts": {
			"paths": [
				"^src/routes/(api/)?contracts/",
				"^src/lib/server/contract-history\\.ts$",
				"^backend/src/routes/contracts\\.ts$",
				"^backend/src/services/contract(\\.service|-tasks\\.service)\\.ts$"
			],
			"features": [
				"features/contract"
			]
		},
		"invoices": {
			"paths": [
				"^src/routes/(api/)?invoices/",
				"^src/lib/server/invoice\\.ts$",
				"^backend/src/routes/invoices\\.ts$",
				"^backend/src/services/invoice(\\.service|-completeness\\.service)\\.ts$"
			],
			"features": [
				"features/invoice"
			]
		},
		"statements": {
			"paths": [
				"^src/routes/(api/)?statements/",
				"^src/lib/server/(statement|statement-actions|statement-generation|cost-reconciliation|missing-statements)\\.ts$",
				"^backend/src/routes/statements\\.ts$",
				"^backend/src/services/statement(\\.service|-invoices\\.service|-payment|-pdf\\.service|-run\\.service|-send\\.service)\\.ts$"
			],
			"features": [
				"features/statement"
			]
		},
		"categories": {
			"paths": [
				"^src/routes/config/categories/",
				"^src/routes/api/categories/",
				"^src/lib/server/category\\.ts$",
				"^backend/src/routes/categories\\.ts$",
				"^backend/src/services/category\\.service\\.ts$"
			],
			"features": [
				"features/categories"
			]
		},
		"distribution-keys": {
			"paths": [
				"^src/routes/config/distribution-keys/",
				"^src/routes/api/distribution-keys/",
				"^src/lib/server/distribution-key\\.ts$",
				"^backend/src/routes/distribution-keys\\.ts$",
				"^backend/src/services/distribution-key\\.service\\.ts$"
			],
			"features": [
				"features/distribution-keys.feature"
			]
		},
		"heating-profiles": {
			"paths": [
				"^src/routes/config/heating-profiles/",
				"^src/lib/server/heating-profile\\.ts$",
				"^backend/src/routes/heating-profiles\\.ts$",
				"^backend/src/services/heating-profile\\.service\\.ts$"
			],
			"features": [
				"features/heating-profiles.feature"
			]
		},
		"documents": {
			"paths": [
				"^src/routes/documents/",
				"^src/lib/server/documents\\.ts$",
				"^backend/src/routes/documents\\.ts$",
				"^backend/src/services/document\\.service\\.ts$"
			],
			"features": [
				"features/documents.feature",
				"features/tenant-documents.feature"
			]
		},
		"dashboard": {
			"paths": [
				"^src/routes/(api/)?dashboard/",
				"^backend/src/routes/dashboard\\.ts$",
				"^backend/src/services/overview-deadlines\\.ts$"
			],
			"features": [
				"features/dashboard.feature"
			]
		},
		"reports": {
			"paths": [
				"^src/routes/reports/",
				"^backend/src/routes/reports\\.ts$"
			],
			"features": [
				"features/reports.feature"
			]
		},
		"help": {
			"paths": [
				"^src/routes/help/"
			],
			"features": [
				"features/help.feature"
			]
		},
		"legal": {
			"paths": [
				"^src/routes/(privacy|terms|analytics)/"
			],
			"features": [
				"features/privacy.feature",
				"features/terms.feature",
				"features/analytics.feature"
			]
		},
		"backup": {
			"paths": [
				"^src/routes/config/backup/",
				"^src/routes/backup/",
				"^src/lib/server/backup\\.ts$",
				"^backend/src/routes/backup\\.ts$",
				"^backend/src/services/(backup\\.service|backup-crypto|emergency-sheet|new-backup-code\\.service)\\.ts$"
			],
			"features": [
				"features/sicherung.feature"
			]
		},
		"access-keys": {
			"paths": [
				"^src/routes/config/access-keys/",
				"^backend/src/routes/access-keys\\.ts$",
				"^backend/src/services/access-key\\.service\\.ts$"
			],
			"features": [
				"features/zugangsschluessel.feature"
			]
		},
		"data-export": {
			"paths": [
				"^src/routes/config/export/",
				"^backend/src/routes/data-export\\.ts$",
				"^backend/src/services/data-export\\.service\\.ts$",
				"^src/lib/server/zip-download\\.ts$"
			],
			"features": [
				"features/datenexport.feature"
			]
		},
		"ki-settings": {
			"paths": [
				"^src/routes/config/ki/",
				"^src/lib/server/ki-settings\\.ts$",
				"^backend/src/routes/ki-settings\\.ts$",
				"^backend/src/services/(ki-settings\\.service|ki-model\\.service)\\.ts$"
			],
			"features": [
				"features/ki-einstellungen.feature",
				"features/categories-ki.feature"
			]
		},
		"setup": {
			"paths": [
				"^src/routes/setup/",
				"^backend/src/services/setup\\.service\\.ts$"
			],
			"features": [
				"features/einrichtung.feature"
			]
		},
		"settings": {
			"paths": [
				"^src/routes/config/[^/]+$",
				"^src/routes/api/config/",
				"^src/lib/server/settings\\.ts$",
				"^backend/src/routes/config\\.ts$",
				"^backend/src/services/(config\\.service|default-setting|export-settings)\\.ts$"
			],
			"features": [
				"features/settings.feature"
			]
		}
	}
}
