{
  "name": "dwello-backend",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Dwello Backend API - ElysiaJS",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../.env --env-file=../.env.local --env-file=.env --env-file=.env.local scripts/migrate.ts && bun --env-file=../.env --env-file=../.env.local --env-file=.env --env-file=.env.local run --hot src/index.ts",
    "dev:demo": "bun run db:demo && bun run dev",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "test": "bun test --coverage && bun scripts/coverage-check.ts",
    "test:pg": "bun test .pg.test",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../.env --env-file=../.env.local --env-file=.env --env-file=.env.local scripts/migrate.ts",
    "db:reset": "bun --env-file=../.env --env-file=../.env.local --env-file=.env --env-file=.env.local scripts/db-reset.ts",
    "account": "bun --env-file=../.env --env-file=../.env.local --env-file=.env --env-file=.env.local scripts/account.ts",
    "restore": "bun --env-file=../.env --env-file=../.env.local --env-file=.env --env-file=.env.local scripts/restore.ts",
    "db:demo": "bun --env-file=../.env --env-file=../.env.local --env-file=.env --env-file=.env.local scripts/demo-data.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "mail-catcher": "bun scripts/mail-catcher.ts",
    "llm-stub": "bun scripts/llm-stub.ts",
    "gwr-stub": "bun scripts/gwr-stub.ts",
    "llm:eval": "bun scripts/llm-eval.ts",
    "e2e-db": "bun scripts/e2e-db.ts",
    "e2e-invoice-without-key": "bun scripts/e2e-invoice-without-key.ts",
    "e2e-purge-statements": "bun scripts/e2e-purge-statements.ts",
    "e2e-backup-reset": "bun scripts/e2e-backup-reset.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "jose": "^6.2.13",
    "nodemailer": "^10.1.4",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/smtp-server": "^3.5.13",
    "drizzle-kit": "^0.31.11",
    "mailparser": "^3.12.4",
    "smtp-server": "^3.21.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "overrides": {
    "file-type": "^21.3.1",
    "nanoid": "^5.1.16",
    "esbuild": "~0.28.0"
  }
}
