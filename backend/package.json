{
  "name": "dwello-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Dwello Backend API - ElysiaJS",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "test": "bun test --path-ignore-patterns='**/*.pg.test.ts' && bun test .pg.test",
    "test:pg": "bun test .pg.test",
    "test:coverage": "bun test --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "mail-catcher": "bun scripts/mail-catcher.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/swagger": "^1.3.1",
    "drizzle-orm": "^0.36.4",
    "elysia": "^1.1.29",
    "jose": "^5.9.6",
    "nodemailer": "^10.0.13",
    "pdfkit": "^0.17.2",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.4",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/smtp-server": "^3.5.13",
    "drizzle-kit": "^0.29.1",
    "mailparser": "^3.9.33",
    "smtp-server": "^3.19.16",
    "typescript": "^5.7.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
