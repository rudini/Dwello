# Demo deployment settings: copy to deploy/demo/.env and fill in (deploy/demo/README.md)
DEMO_DOMAIN=demo.dwello.ch
PUBLIC_APP_URL=https://demo.dwello.ch
COOKIE_DOMAIN=demo.dwello.ch
CORS_ORIGIN=https://demo.dwello.ch

# JWT_SECRET: openssl rand -base64 32
# POSTGRES_PASSWORD: openssl rand -hex 24 (letters and digits only: it goes into DATABASE_URL, where / or + break the URL)
JWT_SECRET=
POSTGRES_PASSWORD=

# Google OAuth client with the redirect URI https://demo.dwello.ch/auth/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=https://demo.dwello.ch/auth/callback

# Every Google account may sign in to the demo (#51); an installation names its own addresses instead
ALLOWED_EMAILS=*

# Visitors may not change the KI: any LLM_* variable locks it to the operator's choice, here the local KI of the
# compose service ollama, so no visitor can make the server send requests to an address of their choice (#1372)
LLM_ENABLED=true

# Named in the terms of use (/terms) and the privacy statement; the demo refuses to start without name and contact (#1170)
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_CONTACT=
