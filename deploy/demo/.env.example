# Demo deployment settings: copy to deploy/demo/.env and fill in (deploy/demo/README.md)
DEMO_DOMAIN=demo.dwello.ch
PUBLIC_APP_URL=https://demo.dwello.ch
COOKIE_DOMAIN=demo.dwello.ch
CORS_ORIGIN=https://demo.dwello.ch

# openssl rand -base64 32 (each)
JWT_SECRET=
POSTGRES_PASSWORD=

# Google OAuth client with the redirect URI https://demo.dwello.ch/auth/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=https://demo.dwello.ch/auth/callback

# Named in the terms of use (/terms)
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_CONTACT=

# Map tiles on the building page (optional)
PUBLIC_CARTO_API_KEY=
