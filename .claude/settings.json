{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autocompact_percentage_override": 75,
  "extraKnownMarketplaces": {
    "fallow-skills": {
      "source": {
        "source": "github",
        "repo": "fallow-rs/fallow-skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "fallow@fallow-skills": true,
    "ponytail@ponytail": true
  },
  "deniedMcpServers": [
    {
      "serverName": "claude_ai_Gmail"
    },
    {
      "serverName": "claude_ai_Google_Calendar"
    },
    {
      "serverName": "notebooklm"
    },
    {
      "serverName": "ide"
    }
  ],
  "permissions": {
    "allow": [
      "Bash(mmx search:*)"
    ],
    "ask": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git reset *--hard*)",
      "Bash(git clean *)",
      "Bash(git checkout .)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git branch -D *)",
      "Bash(git branch *--force*)",
      "Bash(git worktree remove *--force*)",
      "Bash(rm -r*)",
      "Bash(rm -R*)",
      "Bash(rm -f*)",
      "Bash(dropdb dwello)",
      "Bash(dropdb * dwello)",
      "Bash(*db:reset*)",
      "Bash(*db:push*)",
      "Bash(docker compose *down*-v*)",
      "Bash(docker compose *down*--volumes*)"
    ],
    "deny": [
      "Read(node_modules/**)",
      "Read(dist/**)",
      "Read(build/**)",
      "Read(coverage/**)",
      "Read(.svelte-kit/**)",
      "Edit(node_modules/**)",
      "Edit(dist/**)",
      "Edit(build/**)",
      "Read(backend/node_modules/**)",
      "Edit(backend/node_modules/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/fallow-gate.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/deepcheck-gate.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
