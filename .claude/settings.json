{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autocompact_percentage_override": 30,
  "extraKnownMarketplaces": {
    "fallow-skills": {
      "source": {
        "source": "github",
        "repo": "fallow-rs/fallow-skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "fallow@fallow-skills": true,
    "ponytail@ponytail": true
  },
  "deniedMcpServers": [
    {
      "serverName": "claude_ai_Gmail"
    },
    {
      "serverName": "claude_ai_Google_Calendar"
    },
    {
      "serverName": "notebooklm"
    },
    {
      "serverName": "ide"
    }
  ],
  "permissions": {
    "allow": [
      "Bash(mmx search:*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git fetch origin*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge --no-edit origin/main)",
      "Bash(git worktree add *)",
      "Bash(git worktree list*)",
      "Bash(git worktree remove *)",
      "Bash(bun run lint*)",
      "Bash(bun run check*)",
      "Bash(bun run i18n*)",
      "Bash(bun run build*)",
      "Bash(bun run test:coverage*)",
      "Bash(bun run test:e2e*)",
      "Bash(bun run deepcheck:audit*)",
      "Bash(bun run testcheck:audit*)",
      "Bash(bun run type-check*)",
      "Bash(bun run test)",
      "Bash(bun test src/__tests__/*)",
      "Bash(bunx vitest run*)",
      "Bash(bunx fallow audit*)",
      "Bash(bunx bddgen*)",
      "Bash(bunx playwright test*)",
      "Bash(bunx prettier --check *)",
      "Bash(bash docs/design/tools/persona-stack.sh*)",
      "Bash(fuser -k 3300/tcp*)",
      "Bash(fuser -k 3301/tcp*)",
      "Bash(fuser -k 2527/tcp*)",
      "Bash(fuser -k 2528/tcp*)",
      "Bash(fuser -k 2530/tcp*)",
      "Bash(fuser -k 2532/tcp*)",
      "Bash(fuser -k 3100/tcp*)",
      "Bash(fuser -k 3101/tcp*)",
      "Bash(fuser -k 3102/tcp*)",
      "Bash(fuser -k 3103/tcp*)",
      "Bash(fuser -k 3104/tcp*)",
      "Bash(fuser -k 3105/tcp*)",
      "Bash(fuser -k 3106/tcp*)",
      "Bash(bunx svelte-kit sync*)",
      "Bash(node .claude/hooks/commit-msg-gate.mjs --check *)",
      "Bash(node tools/open-work/check-issues.mjs*)",
      "mcp__github__pull_request_read",
      "mcp__github__issue_read",
      "mcp__github__search_issues",
      "mcp__github__get_job_logs",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "mcp__github__get_check_run"
    ],
    "ask": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push *--delete*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git -C * push * main*)",
      "Bash(git -C * push *:main*)",
      "Bash(gh pr merge *--admin*)",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push * -d)",
      "Bash(git reset *--hard*)",
      "Bash(git clean *)",
      "Bash(git checkout .)",
      "Bash(git checkout *-- *)",
      "Bash(git checkout -f*)",
      "Bash(git checkout * -f*)",
      "Bash(git switch -f*)",
      "Bash(git switch * -f*)",
      "Bash(git switch *--discard-changes*)",
      "Bash(git restore *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git branch -D *)",
      "Bash(git branch *--force*)",
      "Bash(git worktree remove *--force*)",
      "Bash(git worktree remove -f*)",
      "Bash(git worktree remove * -f*)",
      "Bash(rm -r*)",
      "Bash(rm -R*)",
      "Bash(rm -f*)",
      "Bash(dropdb dwello)",
      "Bash(dropdb * dwello)",
      "Bash(dropdb dwello *)",
      "Bash(*db:reset*)",
      "Bash(*db:push*)",
      "Bash(docker compose *down*-v*)",
      "Bash(docker-compose *down*-v*)"
    ],
    "deny": [
      "Read(node_modules/**)",
      "Read(dist/**)",
      "Read(build/**)",
      "Read(coverage/**)",
      "Read(.svelte-kit/**)",
      "Edit(node_modules/**)",
      "Edit(dist/**)",
      "Edit(build/**)",
      "Read(backend/node_modules/**)",
      "Edit(backend/node_modules/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/fallow-gate.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/deepcheck-gate.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/testcheck-gate.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/commit-msg-gate.mjs"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/main-push-guard.mjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
