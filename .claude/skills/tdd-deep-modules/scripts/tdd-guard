#!/usr/bin/env python3
"""PreToolUse hook: block edits to production files while no commit may contain production code."""
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from tddcore import protocol  # noqa: E402


def main(raw):
    try:
        event = json.loads(raw)
        tool_input = event.get("tool_input", {})
        path = tool_input.get("file_path")
        if not isinstance(path, (str, type(None))):
            raise TypeError(f"file_path is {type(path).__name__}, not a string")
    except (json.JSONDecodeError, AttributeError, TypeError) as error:
        print(f"tdd-guard: cannot read the hook input: {error}", file=sys.stderr)
        return 1  # a non-blocking error: never stop the user because the hook is broken
    if path is None:
        return 0  # not a file edit
    target = Path(path).resolve()  # no `..` or symlink detours
    existing = next(d for d in target.parents if d.is_dir())  # a Write may create new directories
    # git names the directory's place in the repository, so no path spelling has to match git's
    prefix = subprocess.run(["git", "rev-parse", "--show-prefix"], cwd=existing,
                            capture_output=True, text=True)
    if prefix.returncode != 0:
        if "not a git repository" in prefix.stderr:
            return 0  # outside any git repository: nothing to guard
        reason = (prefix.stderr.strip() or "git failed").splitlines()[0]
        print(f"tdd-guard: cannot check {target.name}: {reason}", file=sys.stderr)
        return 1  # visible, but a broken check must not stop the user
    rel = prefix.stdout.rstrip("\n") + target.relative_to(existing).as_posix()
    subject = subprocess.run(["git", "log", "-1", "--format=%s"], cwd=existing,
                             capture_output=True, text=True).stdout.strip()
    phase = protocol.phase_of(subject)
    if protocol.is_production(rel) and not protocol.production_may_follow(phase):
        print(f"tdd-guard: blocked: {rel} is production code and the last TDD phase is {phase}. "
              "Write one failing test and commit it with `tdd-step red` first.", file=sys.stderr)
        return 2
    return 0


sys.exit(main(sys.stdin.read()))
