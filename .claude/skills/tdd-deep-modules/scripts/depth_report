#!/usr/bin/env python3
"""depth_report <file>...: interface surface, implementation size and depth findings per module."""
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from tddcore import depth  # noqa: E402


def main(paths):
    if not paths:
        print("depth_report: usage: depth_report <file>...", file=sys.stderr)
        return 2
    try:
        modules = [depth.measure(os.getcwd(), path) for path in paths]
    except depth.NotAModule as error:
        print(f"depth_report: {error}", file=sys.stderr)
        return 2
    found = False
    for module in modules:
        verdict = "; ".join(module.findings) or "deep"
        print(f"{module.path}: surface {module.surface}, size {module.size}, ratio {module.ratio:.1f}, "
              f"classitis {'yes' if module.has_classitis else 'no'}, "
              f"pass-through {len(module.pass_through)}, tests {len(module.tests)}, "
              f"unused {len(module.unused)}, duplicate {module.duplicate}"
              f" -> {verdict}")
        found = found or bool(module.findings)
    return 1 if found else 0


sys.exit(main(sys.argv[1:]))
