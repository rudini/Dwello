#!/usr/bin/env python3
"""depth_report <file>...: interface surface, implementation size and depth findings per module."""
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from tddcore import depth  # noqa: E402


def main(paths):
    found = False
    for path in paths:
        module = depth.measure(os.getcwd(), path)
        verdict = "; ".join(module.findings) or "deep"
        print(f"{path}: surface {module.surface}, size {module.size}, ratio {module.ratio:.1f}, "
              f"pass-through {len(module.pass_through)}"
              f" -> {verdict}")
        found = found or bool(module.findings)
    return 1 if found else 0


sys.exit(main(sys.argv[1:]))
