#!/usr/bin/env python3
"""tdd_replay <commit-range>: re-run every commit of the range and check the TDD protocol held."""
import signal
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from tddcore import replay  # noqa: E402


def main(args):
    if len(args) != 1:
        print("usage: tdd_replay <commit-range>", file=sys.stderr)
        return 2
    root = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if root.returncode != 0:
        print("tdd_replay: not inside a git repository", file=sys.stderr)
        return 2
    try:
        verdicts = replay.replay(root.stdout.strip(), args[0])
    except replay.ReplayError as error:
        print(f"tdd_replay: {error}", file=sys.stderr)
        return 2
    except Exception as error:  # a crash must not read as REJECT (exit 1)
        print(f"tdd_replay: internal error: {type(error).__name__}: {error}", file=sys.stderr)
        return 2
    for verdict in verdicts:
        status = "REJECT" if verdict.violations else "ok"
        print(f"{verdict.commit[:7]} {verdict.phase:8} {verdict.run.outcome:5} "
              f"exit={verdict.run.exit_code} {status}")
        for violation in verdict.violations:
            print(f"    - {violation}")
    rejected = any(v.violations for v in verdicts)
    print("REPLAY: REJECT" if rejected else "REPLAY: ACCEPT")
    return 1 if rejected else 0


signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))  # unwind, so the worktree is removed
sys.exit(main(sys.argv[1:]))
