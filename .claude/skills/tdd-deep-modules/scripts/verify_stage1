#!/usr/bin/env python3
"""verify_stage1 [skill-dir]: stage 1 holds when every step's latest review passed."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from tddcore import verdicts  # noqa: E402

skill = Path(sys.argv[1]) if len(sys.argv) > 1 else Path(__file__).resolve().parent.parent
for step in ("01", "02", "03"):
    number, verdict = verdicts.final(skill / "evidence" / "reviews", step)
    print(f"step {step}: {verdict} (round {number})")
print("STAGE1: PASS")
