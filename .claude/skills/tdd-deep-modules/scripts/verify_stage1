#!/usr/bin/env python3
"""verify_stage1 [skill-dir]: the skill's tests pass and every step's latest review passed."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from tddcore import selfcheck, verdicts  # noqa: E402

STEPS = ("01", "02", "03")


def main(skill):
    passed, summary = selfcheck.own_suite(skill / "scripts")
    print(f"tests: {summary}")
    for step in STEPS:
        step_passed, description = verdicts.final(skill / "evidence" / "reviews", step)
        print(f"step {step}: {description}")
        passed = passed and step_passed
    print("STAGE1: PASS" if passed else "STAGE1: FAIL")
    return 0 if passed else 1


sys.exit(main(Path(sys.argv[1]) if len(sys.argv) > 1 else Path(__file__).resolve().parent.parent))
