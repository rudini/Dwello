#!/usr/bin/env python3
"""tdd-step <test|red|green|refactor> [message]: run the tests, then commit the phase."""
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from tddcore import protocol, suite  # noqa: E402


def git(*args):
    return subprocess.run(["git", *args], check=True, capture_output=True, text=True).stdout


def changed_files():
    """Paths changed against HEAD, relative to the repository root; also works before the first commit."""
    entries = iter(git("status", "--porcelain=v1", "-z", "-uall").split("\0"))
    paths = []
    for entry in entries:
        if entry:
            paths.append(entry[3:])
            if entry[0] in "RC":  # a staged rename or copy is followed by its source path
                paths.append(next(entries))
    return sorted(paths)


def head_subject():
    done = subprocess.run(["git", "log", "-1", "--format=%s"], capture_output=True, text=True)
    return done.stdout.strip() if done.returncode == 0 else ""


def main(args):
    if not args or args[0] not in protocol.FOLLOWS:
        print("usage: tdd-step <test|red|green|refactor> [message]", file=sys.stderr)
        return 2
    phase, message = args[0], " ".join(args[1:]) or args[0]
    os.chdir(git("rev-parse", "--show-toplevel").strip())
    try:
        run = suite.run(".")
    except suite.NoFramework as error:
        print(f"tdd-step: {error}", file=sys.stderr)
        return 2
    previous = protocol.phase_of(head_subject())
    found = protocol.violations(previous, phase, run, changed_files())
    if found:
        print("\n".join(f"tdd-step: refused: {v}" for v in found), file=sys.stderr)
        return 1
    git("add", "-A")
    git("commit", "-q", "-m", f"{phase}: {message}",
        "--trailer", f"TDD-Phase: {phase}", "--trailer", f"TDD-Exit-Code: {run.exit_code}")
    return 0


sys.exit(main(sys.argv[1:]))
