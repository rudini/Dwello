#!/usr/bin/env python3
"""tdd-step <test|red|green|refactor> [message]: run the tests, then commit the phase."""
import subprocess
import sys
from pathlib import PurePosixPath


def git(*args):
    return subprocess.run(["git", *args], check=True, capture_output=True, text=True).stdout


def is_code(path):
    return path.endswith(".py")


def is_production(path):
    name = PurePosixPath(path).name
    return is_code(path) and not (name.startswith("test_") or name.endswith("_test.py"))


def changed_files():
    tracked = git("diff", "--name-only", "HEAD").splitlines()
    return sorted(tracked + git("ls-files", "--others", "--exclude-standard").splitlines())


# Phase -> phases it may follow. A red cycle must close with green before anything else.
FOLLOWS = {
    "test": {"start", "test", "green", "refactor"},
    "red": {"start", "test", "green", "refactor"},
    "green": {"red"},
    "refactor": {"green", "refactor"},
}


def last_phase():
    prefix = git("log", "-1", "--format=%s").partition(":")[0]
    return prefix if prefix in ("test", "red", "green", "refactor") else "start"


phase = sys.argv[1]
previous = last_phase()
if previous not in FOLLOWS[phase]:
    sys.exit(f"tdd-step: refused: {phase} cannot follow {previous}")
message = sys.argv[2] if len(sys.argv) > 2 else phase
run = subprocess.run([sys.executable, "-m", "unittest", "discover"], capture_output=True, text=True)
summary = run.stderr.strip().splitlines()[-1]
assertion_failure = summary.startswith("FAILED (failures=") and "errors=" not in summary
if phase == "red" and not assertion_failure:
    sys.exit(f"tdd-step: refused: red needs a failing assertion, but the suite says: {summary}")
if phase in ("green", "refactor") and run.returncode != 0:
    sys.exit(f"tdd-step: refused: {phase} needs all tests passing, but the suite says: {summary}")
code = [f for f in changed_files() if is_code(f)]
if phase == "test" and code:
    sys.exit(f"tdd-step: refused: test phase may only change the test list, not code: {', '.join(code)}")
production = [f for f in changed_files() if is_production(f)]
if phase == "red" and production:
    sys.exit(f"tdd-step: refused: production code changed: {', '.join(production)}")
git("add", "-A")
git("commit", "-q", "-m", f"{phase}: {message}",
    "--trailer", f"TDD-Phase: {phase}",
    "--trailer", f"TDD-Exit-Code: {run.returncode}")
