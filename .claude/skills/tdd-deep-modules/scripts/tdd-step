#!/usr/bin/env python3
"""tdd-step <test|red|green|refactor> [--suite fast|full] [message]: run the tests, commit the phase."""
import os
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from tddcore import protocol, suite  # noqa: E402


def run_git(*args, check=False):
    # surrogateescape keeps file names that are not UTF-8 round-trippable
    return subprocess.run(["git", *args], check=check, capture_output=True, text=True,
                          errors="surrogateescape")


def git(*args):
    return run_git(*args, check=True).stdout


def changed_files():
    """Paths changed against HEAD, relative to the repository root, even before the first commit."""
    entries = iter(git("status", "--porcelain=v1", "-z", "-uall").split("\0"))
    paths = []
    for entry in entries:
        if entry:
            paths.append(entry[3:])
            if entry[0] in "RC":  # a staged rename or copy is followed by its source path
                paths.append(next(entries))
    return sorted(paths)


def snapshot():
    """Tree id of the working tree as `git add -A` would commit it, without touching the index."""
    with tempfile.TemporaryDirectory() as tmp:
        index = {**os.environ, "GIT_INDEX_FILE": str(Path(tmp) / "index")}
        subprocess.run(["git", "add", "-A"], env=index, check=True, capture_output=True)
        return subprocess.run(["git", "write-tree"], env=index, check=True, capture_output=True,
                              text=True).stdout.strip()


def head_subject():
    done = run_git("log", "-1", "--format=%s")
    return done.stdout.strip() if done.returncode == 0 else ""


def head_suite():
    done = run_git("log", "-1", "--format=%(trailers:key=TDD-Suite,valueonly)")
    return done.stdout.strip() if done.returncode == 0 else ""


def main(args):
    phase, rest = (args[0], args[1:]) if args else (None, [])
    tier = "full" if phase == "refactor" else "fast"
    if rest[:1] == ["--suite"]:
        tier, rest = (rest + [None])[1], rest[2:]
    if phase not in protocol.PHASES or tier not in ("fast", "full"):
        print("usage: tdd-step <test|red|green|refactor> [--suite fast|full] [message]",
              file=sys.stderr)
        return 2
    message = " ".join(" ".join(rest).split()) or phase
    root = run_git("rev-parse", "--show-toplevel")
    if root.returncode != 0:
        print("tdd-step: not inside a git repository", file=sys.stderr)
        return 2
    os.chdir(root.stdout.strip())
    before = snapshot()
    try:
        run = suite.run(".", tier)
    except suite.NoFramework as error:
        print(f"tdd-step: {error}", file=sys.stderr)
        return 2
    after = snapshot()
    if after != before:
        touched = git("diff", "--name-only", before, after).splitlines()
        print(f"tdd-step: refused: the test run changed the working tree: {', '.join(touched)}",
              file=sys.stderr)
        return 1
    previous = protocol.phase_of(head_subject())
    found = protocol.violations(previous, phase, run, changed_files(), tier, head_suite())
    if found:
        print("\n".join(f"tdd-step: refused: {v}" for v in found), file=sys.stderr)
        return 1
    index = git("write-tree").strip()
    git("add", "-A")
    done = run_git("commit", "-q", "-m", f"{phase}: {message}", "--trailer", f"TDD-Phase: {phase}",
                   "--trailer", f"TDD-Exit-Code: {run.exit_code}", "--trailer", f"TDD-Suite: {tier}")
    if done.returncode != 0:
        git("read-tree", index)
        print(f"tdd-step: git commit failed:\n{done.stderr}{done.stdout}", file=sys.stderr)
        return 2
    return 0


sys.exit(main(sys.argv[1:]))
