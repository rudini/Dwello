#!/usr/bin/env python3
"""tdd-step <test|red|green|refactor> [message]: run the tests, then commit the phase."""
import subprocess
import sys

phase = sys.argv[1]
message = sys.argv[2] if len(sys.argv) > 2 else phase
run = subprocess.run([sys.executable, "-m", "unittest", "discover"], capture_output=True, text=True)
summary = run.stderr.strip().splitlines()[-1]
if phase == "red" and (run.returncode == 0 or "errors=" in summary):
    sys.exit(f"tdd-step: refused: red needs a failing assertion, but the suite says: {summary}")
subprocess.run(["git", "add", "-A"], check=True)
subprocess.run(["git", "commit", "-q", "-m", f"{phase}: {message}",
                "--trailer", f"TDD-Phase: {phase}",
                "--trailer", f"TDD-Exit-Code: {run.returncode}"], check=True)
