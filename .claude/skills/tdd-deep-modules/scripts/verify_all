#!/usr/bin/env python3
"""verify_all [skill-dir]: prints every check of stage 2 and STAGE2: PASS or FAIL (rule: tddcore/gate.py)."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from tddcore import gate  # noqa: E402

passed, lines = gate.stage2(Path(sys.argv[1]) if len(sys.argv) > 1 else Path(__file__).resolve().parent.parent)
print("\n".join(lines))
sys.exit(0 if passed else 1)
