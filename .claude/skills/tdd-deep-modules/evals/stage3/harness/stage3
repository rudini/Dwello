#!/usr/bin/env python3
"""stage3: run the arms, review them blind and judge the stage-3 depth experiment (see ../README.md).

  stage3 run <fixture-dir> <arm> <run-id>          one sandboxed arm run, then all measurements
  stage3 batch <jobs> <spec>...                     several runs in parallel; spec = fixture-dir:arm:run-id
  stage3 review <group> <fixture-dir> baseline=<run-id> canon=<run-id> skill=<run-id> [--control]
  stage3 gate [--phase pilot|main]                  tables and the STAGE3 verdict
  stage3 validate                                   check every fixture; prints counts only (hold-outs stay unread)

Run ids: <phase>-<fixture>-<arm>-r<slot>-a<attempt> (attempts 1, 2, ...); group names:
<phase>-<fixture>-r<slot>[.<attempt>] (attempts 2, 3, ...). Nothing is ever overwritten: a run id or review
group that exists is refused, and the gate fails on gaps, on attempts after a slot's first valid run or a
group's first complete review, and on run directories or transcripts without a record.
"""
import gzip
import json
import os
import random
import re
import shutil
import subprocess
import sys
import tarfile
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

HARNESS = Path(__file__).resolve().parent
STAGE3 = HARNESS.parent
SKILL = STAGE3.parent.parent
RESULTS = Path(os.environ.get("STAGE3_RESULTS", STAGE3 / "results"))
# Must lie under a directory sandbox.sh hides, so no session can see another run.
WORK = Path(os.environ.get("STAGE3_WORK", "/tmp/claude-0/-home-user-Dwello/"
                           "b911e014-6a0a-558d-a301-60af5eecb558/scratchpad/stage3"))
MODEL = "claude-opus-5-5"
ARMS = {"baseline": "baseline.md", "canon": "canon-tdd.md", "skill": "tdd-deep-modules.md"}
RUN_ID = re.compile(r"^(?P<phase>pilot|main)-(?P<fixture>[a-z0-9-]+)-(?P<arm>baseline|canon|skill)"
                    r"-r(?P<slot>[1-9]\d*)-a(?P<attempt>[1-9]\d*)$")
GROUP = re.compile(r"^(?P<phase>pilot|main)-(?P<fixture>[a-z0-9-]+)-r(?P<slot>[1-9]\d*)"
                   r"(?:\.(?P<attempt>[2-9]|[1-9]\d+))?$")
# Every session, and every command that runs an arm's code, runs in its own mount and PID namespace
# (sandbox.sh): it sees only its directory, as /workspace, and cannot unmount what hides the rest.
SANDBOX = ["unshare", "-m", "-p", "-f", "--mount-proc", "--propagation", "private", str(HARNESS / "sandbox.sh")]
# Tools that add side channels or variance, refused identically for arms and reviewers.
NO_EXTRAS = ["WebFetch", "WebSearch", "Agent", "Task", "Workflow", "Artifact", "SendMessage", "CronCreate",
             "CronDelete", "CronList", "PushNotification", "ScheduleWakeup", "RemoteTrigger", "Monitor"]
ARM_TOOLS = ["--permission-mode", "acceptEdits", "--disallowedTools", *NO_EXTRAS,
             "--allowedTools", "Skill", "Bash(bun *)", "Bash(bunx *)", "Bash(git *)", "Bash(ls *)",
             "Bash(mkdir *)", "Bash(cat *)", "Bash(head *)", "Bash(tail *)", "Bash(wc *)", "Bash(grep *)",
             "Bash(echo *)", "Bash(pwd)", "Bash(diff *)", "Bash(.claude/skills/tdd-deep-modules/scripts/*)",
             "Bash(./.claude/skills/tdd-deep-modules/scripts/*)",
             "Bash(python3 .claude/skills/tdd-deep-modules/scripts/*)"]
REVIEW_TOOLS = ["--permission-mode", "default", "--disallowedTools", "Bash", "Edit", "Write",
                "NotebookEdit", "Skill", *NO_EXTRAS]
# A child session gets only what it needs to run; no tokens, git credentials or parent-session identity.
# Its shells source /sandbox/env.sh (sandbox-env/env.sh): no proxy for commands, git only for local repos.
KEEP_ENV = ("PATH", "HOME", "SHELL", "TERM", "LANG", "ANTHROPIC_BASE_URL", "HTTPS_PROXY", "https_proxy",
            "NO_PROXY", "no_proxy", "SSL_CERT_FILE", "NODE_EXTRA_CA_CERTS", "REQUESTS_CA_BUNDLE",
            "CURL_CA_BUNDLE", "BUN_INSTALL", "CLAUDE_SESSION_INGRESS_TOKEN_FILE", "SESSION_INGRESS_URL",
            "CLAUDE_CODE_PROVIDER_MANAGED_BY_HOST", "CLAUDE_CODE_PROXY_RESOLVES_HOSTS", "CLAUDE_CODE_REMOTE",
            "CLAUDE_CODE_ENTRYPOINT", "CLAUDE_EFFORT", "MAX_THINKING_TOKENS", "DISABLE_AUTOUPDATER",
            "IS_SANDBOX", "NODE_OPTIONS", "CLAUDE_CODE_USE_CCR_V2")
SESSION_SHELL = {"BASH_ENV": "/sandbox/env.sh", "ENV": "/sandbox/env.sh", "GIT_CONFIG_GLOBAL": "/dev/null",
                 "GIT_CONFIG_NOSYSTEM": "1", "GIT_ALLOW_PROTOCOL": "file", "GIT_TERMINAL_PROMPT": "0"}
PROXY_ENV = {"HTTPS_PROXY", "https_proxy", "NO_PROXY", "no_proxy"}
# What a session's commands and reads have no business naming: other places, the network, the host.
# Such a run is invalid (decided before any run); nothing outside /workspace is readable anyway.
FOREIGN = re.compile(r"/home/|/tmp\b|/root/|/mnt/|/srv/|/proc/|/sys/|/sandbox|/verifier|~/|\$HOME|\bDwello\b|"
                     r"\bevals\b|\bstage3\b|https?://|\bgithub|\bproxy|\bcurl\b|\bwget\b|\bfetch\(|"
                     r"\b(?:u?mount|unshare|nsenter|chroot)\b|"
                     r"(?:^|[\s=('\"])/(?=[\s'\")]|$)|(?:^|[\s'\"(])\.\./\.\.", re.I)
SCANNED_TOOLS = {"Bash", "Read", "Glob", "Grep", "LS", "NotebookRead"}
CODE = (".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs")
IMPORT = re.compile(r"""(?:\bfrom\s*|\bimport\s*\(\s*|\bimport\s+|\brequire\s*\(\s*)["'](\.{1,2}/[^"']+)["']""")
ARM_TIMEOUT, TEST_TIMEOUT, REPLAY_TIMEOUT, REVIEW_TIMEOUT = 5400, 600, 3600, 1800
REVIEW_PROMPT = """You are reviewing the design of {n} independent implementations of the same task. TASK.md \
describes the task. The directories {labels} each contain one implementation's production source code; \
comments were removed and the code was reformatted mechanically, and tests are not included. Read every \
file of every implementation before you rate.

Rate each implementation's module depth in John Ousterhout's sense (A Philosophy of Software Design) on an \
integer scale from 1 to 10. A deep module offers an interface that is small and simple compared with the \
functionality and the design decisions it hides; a shallow module's interface is about as complex as what \
it does. 10: the implementation is built from deep modules; 1: it is built from shallow ones. Judge depth \
only, not correctness, naming style, size or performance. Rate each implementation on its own merits; equal \
scores are allowed.

Give a short justification per implementation (2 to 4 sentences naming concrete modules and functions), \
then end your answer with exactly one fenced json block of the form {{"scores": {{"A": 5, ...}}}} \
covering every directory."""


def sh(cmd, cwd, timeout=TEST_TIMEOUT):
    try:
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout + p.stderr
    except subprocess.TimeoutExpired as e:
        return 124, f"timeout after {timeout}s: {e}"


def git(repo, *args):
    # An arm's repository config must not run anything on the host (fsmonitor, hooks).
    code, out = sh(["git", "-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null", *args], repo)
    if code:
        raise RuntimeError(f"git {' '.join(args)}: {out}")
    return out.strip()


def session_env(proxy=True, verifier=False):
    env = {k: os.environ[k] for k in KEEP_ENV if k in os.environ and (proxy or k not in PROXY_ENV)}
    env.update(SESSION_SHELL)
    if verifier:
        env["STAGE3_VERIFIER"] = str(SKILL)
    return env


def in_sandbox(cmd, directory, timeout=TEST_TIMEOUT, verifier=False):
    """Run an arm's code (its tests, the hidden tests, the replay) where it sees nothing but `directory`."""
    try:
        p = subprocess.run([*SANDBOX, str(directory), *cmd], env=session_env(proxy=False, verifier=verifier),
                           capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout + p.stderr
    except subprocess.TimeoutExpired as e:
        return 124, f"timeout after {timeout}s: {e}"


def claude(directory, prompt, out_path, tools, timeout):
    """Run a fresh headless Claude Code session that sees only `directory` (as /workspace)."""
    if out_path.exists():
        raise RuntimeError(f"{out_path} exists; nothing is overwritten")
    cmd = [*SANDBOX, str(directory), "claude", "-p", "--output-format", "stream-json", "--verbose",
           "--model", MODEL, *tools]
    try:
        p = subprocess.run(cmd, env=session_env(), input=prompt, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           text=True, timeout=timeout)
        text = p.stdout
    except subprocess.TimeoutExpired as e:
        text = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
        text += '\n{"type": "result", "is_error": true, "result": "harness timeout"}\n'
    with gzip.open(out_path, "wt") as out:
        out.write(text)
    events = []
    for line in text.splitlines():
        try:
            events.append(json.loads(line))
        except ValueError:
            pass
    result = next((e for e in reversed(events) if isinstance(e, dict) and e.get("type") == "result"),
                  {"is_error": True})
    return result, [e for e in events if isinstance(e, dict)]


def blocks(events, kind):
    for e in events:
        message = e.get("message") if isinstance(e.get("message"), dict) else {}
        for block in message.get("content") or []:
            if isinstance(block, dict) and block.get("type") == kind:
                yield block


def foreign_references(events):
    """Commands and reads that name a place outside the session's directory, the network or the host."""
    return sorted({f"{b.get('name')}: {json.dumps(b.get('input'))[:300]}" for b in blocks(events, "tool_use")
                   if b.get("name") in SCANNED_TOOLS and FOREIGN.search(json.dumps(b.get("input")))})


def skill_loaded(events):
    """The session called the Skill tool for tdd-deep-modules and the call succeeded."""
    calls = {b.get("id") for b in blocks(events, "tool_use")
             if b.get("name") == "Skill" and "tdd-deep-modules" in json.dumps(b.get("input"))}
    return any(b.get("tool_use_id") in calls and not b.get("is_error") for b in blocks(events, "tool_result"))


def tree_files(repo):
    return [f for f in git(repo, "ls-files", "-co", "--exclude-standard", "-z").split("\0") if f]


def resolve(repo, files, spec, importer_dir):
    base = os.path.normpath(os.path.join(importer_dir, spec))
    stem = re.sub(r"\.(?:m|c)?js$", "", base)
    for candidate in (base, *(stem + s for s in CODE), *(f"{base}/index{s}" for s in CODE)):
        if candidate in files:
            return candidate
    return None


def production_files(repo, fixture):
    """The import closure of the modules the hidden tests import: what the product consists of."""
    files = set(tree_files(repo))
    todo = []
    for test in (fixture / "hidden").glob("*"):
        for spec in IMPORT.findall(test.read_text()):
            found = resolve(repo, files, spec, "__acceptance__")
            if found:
                todo.append(found)
    seen = set()
    while todo:
        rel = todo.pop()
        if rel in seen or not rel.endswith(CODE):
            continue
        seen.add(rel)
        for spec in IMPORT.findall((repo / rel).read_text(errors="replace")):
            found = resolve(repo, files, spec, os.path.dirname(rel))
            if found:
                todo.append(found)
    return sorted(seen)


def bun_counts(out):
    def count(word):
        m = re.search(rf"^\s*(\d+) {word}\b", out, re.M)
        return int(m.group(1)) if m else 0
    return count("pass"), count("fail")


def prepare(fixture, arm, run_dir):
    repo = run_dir / "repo"
    shutil.copytree(fixture / "starter", repo)
    if arm == "skill":
        target = repo / ".claude/skills/tdd-deep-modules"
        target.mkdir(parents=True)
        shutil.copy2(SKILL / "SKILL.md", target / "SKILL.md")
        shutil.copytree(SKILL / "references", target / "references")
        shutil.copytree(SKILL / "scripts", target / "scripts",
                        ignore=shutil.ignore_patterns("tests", "__pycache__", ".fallow"))
    git(repo, "init", "-q", "-b", "main")
    git(repo, "config", "user.name", "Developer")
    git(repo, "config", "user.email", "dev@example.invalid")
    git(repo, "add", "-A")
    git(repo, "commit", "-q", "-m", "start")
    preamble = (STAGE3 / "arms" / ARMS[arm]).read_text().strip()
    task = (fixture / "task.md").read_text().strip()
    common = (STAGE3 / "arms/common.md").read_text().strip()
    return repo, "\n\n".join(part for part in (preamble, task, common) if part) + "\n"


def depth(repo, files):
    if not files:
        return {"exit": None, "lines": [], "findings": 0, "surface": 0, "size": 0}
    code, out = sh([str(SKILL / "scripts/depth_report"), *files], repo)
    lines = [line for line in out.splitlines() if line.strip()]
    total = lambda word: sum(int(m.group(1)) for line in lines if (m := re.search(rf"{word} (\d+)", line)))
    findings = sum(len(line.split(" -> ", 1)[1].split("; ")) for line in lines if " -> " in line)
    return {"exit": code, "lines": lines, "findings": findings, "surface": total("surface"), "size": total("size")}


def measure(fixture, arm, repo, base, events):
    check = repo.parent / "check"
    for rel in tree_files(repo):
        if not rel.startswith(".claude/") and (repo / rel).is_file():
            (check / rel).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(repo / rel, check / rel)
    code, out = in_sandbox(["bun", "test"], check)
    own = {"exit": code, "pass": bun_counts(out)[0], "fail": bun_counts(out)[1]}
    shutil.copytree(fixture / "hidden", check / "__acceptance__")
    code, out = in_sandbox(["bun", "test", "./__acceptance__"], check)
    hidden = {"exit": code, "pass": bun_counts(out)[0], "fail": bun_counts(out)[1], "tail": out[-1500:]}
    production = production_files(repo, fixture)
    loaded = skill_loaded(events) if arm == "skill" else None
    passed = hidden["exit"] == 0 and hidden["fail"] == 0 and hidden["pass"] > 0
    committed = git(repo, "status", "--porcelain") == ""
    foreign = foreign_references(events)
    m = {"own_tests": own, "hidden": hidden, "production_files": production, "skill_loaded": loaded,
         "foreign_references": foreign, "committed": committed,
         "valid": passed and committed and loaded is not False and not foreign,
         "commits": int(git(repo, "rev-list", "--count", f"{base}..HEAD")),
         "subjects": git(repo, "log", "--format=%s", f"{base}..HEAD").splitlines()[::-1],
         "depth": depth(repo, production), "replay": None}
    if arm == "skill":
        code, out = in_sandbox(["/verifier/scripts/tdd_replay", f"{base}..HEAD"], repo, REPLAY_TIMEOUT,
                               verifier=True)
        verdict = "ACCEPT" if "REPLAY: ACCEPT" in out else "REJECT" if "REPLAY: REJECT" in out else "ERROR"
        m["replay"] = {"exit": code, "verdict": verdict, "out": out[-4000:]}
    return m


def run(fixture, arm, run_id):
    fixture = Path(fixture).resolve()
    parsed = RUN_ID.match(run_id)
    if not parsed or parsed["arm"] != arm or parsed["fixture"] != fixture.name:
        raise ValueError(f"run id {run_id} does not match <phase>-{fixture.name}-{arm}-r<slot>-a<attempt>")
    run_dir, out_dir = WORK / "runs" / run_id, RESULTS / "runs"
    if run_dir.exists() or (out_dir / f"{run_id}.json").exists():
        raise RuntimeError(f"{run_id} exists; nothing is overwritten, use the next attempt number")
    out_dir.mkdir(parents=True, exist_ok=True)
    started = time.time()
    record = {"run_id": run_id, "status": "started", "phase": parsed["phase"], "slot": int(parsed["slot"]),
              "attempt": int(parsed["attempt"]), "fixture": fixture.name,
              "fixture_dir": f"{fixture.parent.name}/{fixture.name}", "arm": arm,
              "started": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(started)), "valid": False}
    (out_dir / f"{run_id}.json").write_text(json.dumps(record, indent=1) + "\n")  # a crash stays a failed attempt
    repo, prompt = prepare(fixture, arm, run_dir)
    base = git(repo, "rev-parse", "HEAD")
    (run_dir / "prompt.txt").write_text(prompt)
    result, events = claude(repo, prompt, out_dir / f"{run_id}.stream.jsonl.gz", ARM_TOOLS, ARM_TIMEOUT)
    record.update({"status": "finished", "base": base, "duration_s": round(time.time() - started),
                   "session": {k: result.get(k) for k in ("is_error", "num_turns", "total_cost_usd",
                                                         "session_id", "permission_denials")},
                   "final_message": str(result.get("result", ""))[-2000:]})
    record.update(measure(fixture, arm, repo, base, events))
    git(repo, "bundle", "create", str(out_dir / f"{run_id}.bundle"), "--all")
    with tarfile.open(out_dir / f"{run_id}.tree.tgz", "w:gz") as tar:
        for rel in tree_files(repo):
            if not rel.startswith(".claude/"):
                tar.add(repo / rel, arcname=rel)
    (out_dir / f"{run_id}.json").write_text(json.dumps(record, indent=1) + "\n")
    replay = record["replay"]["verdict"] if record["replay"] else "-"
    print(f"{run_id}: valid={record['valid']} hidden={record['hidden']['pass']}/{record['hidden']['fail']} "
          f"skill_loaded={record['skill_loaded']} replay={replay} findings={record['depth']['findings']} "
          f"foreign={len(record['foreign_references'])} committed={record['committed']} "
          f"{record['duration_s']}s", flush=True)
    return record


def batch(jobs, specs):
    def one(spec):
        fixture, arm, run_id = spec.rsplit(":", 2)
        try:
            run(fixture, arm, run_id)
        except Exception as e:  # one broken run must not stop the others
            print(f"{run_id}: HARNESS ERROR {type(e).__name__}: {e}", flush=True)
    with ThreadPoolExecutor(jobs) as pool:
        list(pool.map(one, specs))


def bundle_for_review(view, fixture, runs, control):
    """One reviewer's view: TASK.md plus each arm's stripped production code under a random letter."""
    entries = list(runs.items()) + ([(f"control:{control}", runs[control])] if control else [])
    random.SystemRandom().shuffle(entries)
    labels = [chr(ord("A") + i) for i in range(len(entries))]
    view.mkdir(parents=True)
    shutil.copy2(fixture / "task.md", view / "TASK.md")
    for label, (arm, run_id) in zip(labels, entries):
        repo = WORK / "runs" / run_id / "repo"
        record = json.loads((RESULTS / "runs" / f"{run_id}.json").read_text())
        for rel in record["production_files"]:
            code, out = sh(["node", str(HARNESS / "strip.cjs"), str(repo / rel), str(view / label / rel)], STAGE3)
            if code:
                raise RuntimeError(f"strip {rel}: {out}")
    return dict(zip(labels, [arm for arm, _ in entries])), labels


def review_once(group, fixture, runs, control, k):
    view = WORK / "reviews" / group / f"rev{k}"
    key, labels = bundle_for_review(view, fixture, runs, control)
    prompt = REVIEW_PROMPT.format(n=len(labels), labels=", ".join(labels))
    out_dir = RESULTS / "reviews" / group
    result, events = claude(view, prompt, out_dir / f"rev{k}.stream.jsonl.gz", REVIEW_TOOLS, REVIEW_TIMEOUT)
    text = str(result.get("result", ""))
    found = re.findall(r"```json\s*(\{.*?\})\s*```", text, re.S)
    try:
        scores = json.loads(found[-1])["scores"] if found else {}
    except (ValueError, KeyError, TypeError):
        scores = {}
    by_arm = {key[label]: scores.get(label) for label in labels}
    record = {"group": group, "reviewer": k, "key": key, "runs": runs, "scores_by_label": scores,
              "scores": by_arm, "complete": all(type(v) is int and 1 <= v <= 10 for v in by_arm.values()),
              "cost": result.get("total_cost_usd"), "permission_denials": result.get("permission_denials"),
              "foreign_references": foreign_references(events), "text": text}
    (out_dir / f"rev{k}.json").write_text(json.dumps(record, indent=1) + "\n")
    return record


def sign(x):
    return (x > 0) - (x < 0)


def comparisons(scores):
    return {"vs_baseline": sign(scores["skill"] - scores["baseline"]),
            "vs_canon": sign(scores["skill"] - scores["canon"])}


def review(group, fixture, runs, control):
    fixture = Path(fixture).resolve()
    if not GROUP.match(group):
        raise ValueError(f"group {group} does not match <phase>-<fixture>-r<slot>[.<attempt>]")
    out_dir = RESULTS / "reviews" / group
    if out_dir.exists() or (WORK / "reviews" / group).exists():
        raise RuntimeError(f"{group} exists; nothing is overwritten, use <group>.<attempt>")
    out_dir.mkdir(parents=True)
    (out_dir / "group.json").write_text(json.dumps({"group": group, "fixture": fixture.name, "runs": runs,
                                                    "control": control}, indent=1) + "\n")
    with ThreadPoolExecutor(2) as pool:
        first = list(pool.map(lambda k: review_once(group, fixture, runs, control, k), (1, 2)))
    if not all(r["complete"] for r in first):
        raise RuntimeError(f"{group}: a reviewer gave no complete score set; review again as <group>.<attempt>")
    a, b = (comparisons(r["scores"]) for r in first)
    if a != b and not review_once(group, fixture, runs, control, 3)["complete"]:
        raise RuntimeError(f"{group}: reviewer 3 gave no complete score set; review again as <group>.<attempt>")
    print(f"{group}: " + "  ".join(f"rev{r['reviewer']} {r['scores']}" for r in first) +
          ("" if a == b else "  -> disagreement, rev3 added"), flush=True)


def group_verdict(group_dir):
    """(reviews, final comparisons) of a complete group, or (reviews, None) when it is incomplete."""
    revs = [json.loads(p.read_text()) for p in sorted(group_dir.glob("rev[0-9].json"))]
    if len(revs) < 2 or not (revs[0]["complete"] and revs[1]["complete"]):
        return revs, None
    comps = [comparisons(r["scores"]) for r in revs]
    disagree = comps[0] != comps[1]
    if disagree and (len(revs) < 3 or not revs[2]["complete"]):
        return revs, None
    final = {}
    for name in ("vs_baseline", "vs_canon"):
        votes = [c[name] for c in comps[:3]] if disagree else [comps[0][name]]
        best = max(set(votes), key=votes.count)
        final[name] = best if votes.count(best) * 2 > len(votes) else 0
    return revs[:3] if disagree else revs[:2], final


def latest_review(step):
    rounds = [p for p in SKILL.glob(f"evidence/reviews/step-{step:02d}-round-*.md")
              if re.search(r"round-\d+\.md$", p.name)]
    if not rounds:
        return None, None
    last = max(rounds, key=lambda p: int(re.search(r"round-(\d+)\.md$", p.name).group(1)))
    lines = last.read_text().rstrip().splitlines()
    return last.name, bool(lines) and lines[-1] == "VERDICT: PASS"


def fixtures():
    found = {}
    for kind in ("fixtures", "holdout"):
        for d in sorted((STAGE3 / kind).glob("*/meta.json")):
            found[d.parent.name] = kind
    return found


def load_runs(phase):
    runs = {}
    for p in (RESULTS / "runs").glob(f"{phase}-*.json"):
        rec = json.loads(p.read_text())
        runs[rec["run_id"]] = rec
    return runs


def gate(phase):
    ok, notes, rows, per_fixture = True, [], [], {}
    all_runs = load_runs(phase)
    slots = {}
    for rec in all_runs.values():
        slots.setdefault((rec["fixture"], rec["arm"], rec["slot"]), []).append(rec)
    first_valid = {key: next((r for r in sorted(recs, key=lambda r: r["attempt"]) if r["valid"]), None)
                   for key, recs in slots.items()}
    for key, recs in sorted(slots.items()):
        numbers = sorted(r["attempt"] for r in recs)
        if numbers != list(range(1, len(numbers) + 1)):
            ok = False
            notes.append(f"{key}: attempts {numbers} are not 1..n")
        chosen = first_valid[key]
        if chosen and any(r["attempt"] > chosen["attempt"] for r in recs):
            ok = False
            notes.append(f"{key}: attempts after the first valid one ({chosen['run_id']})")
    recorded = set(all_runs)
    orphans = sorted({p.name for p in (WORK / "runs").glob(f"{phase}-*")} - recorded) + sorted(
        {p.name[:-len(".stream.jsonl.gz")] for p in (RESULTS / "runs").glob(f"{phase}-*.stream.jsonl.gz")} - recorded)
    if orphans:
        ok = False
        notes.append(f"run directories or transcripts without a record: {orphans}")
    for rec in sorted(all_runs.values(), key=lambda r: r["run_id"]):
        if rec["status"] != "finished":
            notes.append(f"invalid run {rec['run_id']}: harness did not finish it (failure case, slot rerun)")
            continue
        if not rec["valid"]:
            notes.append(f"invalid run {rec['run_id']}: hidden {rec['hidden']['pass']}/{rec['hidden']['fail']}"
                         f" committed={rec['committed']} skill_loaded={rec['skill_loaded']}"
                         f" foreign={rec['foreign_references'][:3]} (failure case, slot rerun)")
        if rec["arm"] == "skill" and rec["valid"] and rec["replay"]["verdict"] != "ACCEPT":
            ok = False
            notes.append(f"tdd_replay {rec['replay']['verdict']} for valid arm-3 run {rec['run_id']}")
    attempts = {}
    for g in (RESULTS / "reviews").glob(f"{phase}-*"):
        m = GROUP.match(g.name)
        if g.is_dir() and m:
            attempts.setdefault(f"{m['phase']}-{m['fixture']}-r{m['slot']}", []).append((int(m["attempt"] or 1), g))
    controls = []
    for name, tries in sorted(attempts.items()):
        tries.sort()
        complete = [n for n, g in tries if group_verdict(g)[1] is not None]
        if [n for n, _ in tries] != list(range(1, len(tries) + 1)):
            ok = False
            notes.append(f"{name}: review attempts {[n for n, _ in tries]} are not 1..n")
        if complete and tries[-1][0] > complete[0]:
            ok = False
            notes.append(f"{name}: review attempts after the first complete one")
        chosen = next(((g, *group_verdict(g)) for _, g in tries if group_verdict(g)[1] is not None), None)
        if len(tries) > 1:
            notes.append(f"{name}: {len(tries)} review attempts; incomplete ones: "
                         f"{[g.name for _, g in tries if group_verdict(g)[1] is None]}")
        if not chosen:
            ok = False
            notes.append(f"{name}: no complete review")
            continue
        g, revs, final = chosen
        meta = GROUP.match(name)
        runs = revs[0]["runs"]
        records = {arm: all_runs.get(rid) for arm, rid in runs.items()}
        problems = []
        if set(runs) != set(ARMS) or len(set(runs.values())) != 3 or any(r is None for r in records.values()):
            problems.append("runs are not three distinct recorded runs of this phase")
        else:
            for arm, rec in records.items():
                if rec["arm"] != arm or rec["fixture"] != meta["fixture"] or rec["slot"] != int(meta["slot"]):
                    problems.append(f"{rec['run_id']} is not the {arm} run of this fixture and slot")
                elif first_valid.get((rec["fixture"], arm, rec["slot"])) is not rec:
                    problems.append(f"{rec['run_id']} is not the first valid attempt of its slot")
        if any(r["runs"] != runs for r in revs):
            problems.append("reviewers saw different runs")
        if problems:
            ok = False
            notes += [f"{name}: {p}" for p in problems]
            continue
        replay = records["skill"]["replay"]["verdict"]
        per_fixture.setdefault(meta["fixture"], []).append(final)
        scores = " | ".join(" ".join(f"{arm[0]}{r['scores'][arm]}" for arm in ("baseline", "canon", "skill"))
                            + (f" k{r['scores']['control:baseline']}" if "control:baseline" in r["scores"] else "")
                            for r in revs)
        for r in revs:
            if "control:baseline" in r["scores"]:
                delta = abs(r["scores"]["control:baseline"] - r["scores"]["baseline"])
                controls.append(f"{g.name} rev{r['reviewer']}: control delta {delta}"
                                + (" UNRELIABLE" if delta > 1 else ""))
            if r["foreign_references"]:
                ok = False
                notes.append(f"{g.name} rev{r['reviewer']}: names places outside its sandbox")
        depth = " ".join(f"{arm[0]}:{records[arm]['depth']['findings']}/{len(records[arm]['production_files'])}"
                         for arm in ("baseline", "canon", "skill"))
        rows.append(f"{g.name:34} {scores:40} vs_base {final['vs_baseline']:+d} vs_canon {final['vs_canon']:+d}"
                    f"  replay {replay:6} depth_report findings/files {depth}")
    print("scores per reviewer (b=baseline c=canon s=skill k=control copy of baseline)")
    print("\n".join(rows))
    attribution = bool(per_fixture)
    print("\nper fixture: skill vs baseline, skill vs canon (wins/ties/losses)")
    for fixture, finals in sorted(per_fixture.items()):
        wb, wc = [f["vs_baseline"] for f in finals], [f["vs_canon"] for f in finals]
        fx_ok = wb.count(1) * 2 > len(wb) and wb.count(-1) == 0
        attribution &= wc.count(1) * 2 > len(wc)
        print(f"  {fixture:24} n={len(finals)}  baseline {wb.count(1)}/{wb.count(0)}/{wb.count(-1)}"
              f"  canon {wc.count(1)}/{wc.count(0)}/{wc.count(-1)}  {'ok' if fx_ok else 'NOT MET'}")
        ok &= fx_ok
    if controls:
        print("\n" + "\n".join(controls))
    if phase == "pilot":
        print("\n" + "\n".join(notes))
        return 0
    expected = fixtures()
    for fixture, kind in expected.items():
        n = len(per_fixture.get(fixture, []))
        if n != 3:
            ok = False
            notes.append(f"{fixture} ({kind}): {n} reviewed runs, 3 required")
    holdout = [f for f, k in expected.items() if k == "holdout"]
    if len(expected) - len(holdout) < 4 or len(holdout) < 2:
        ok = False
        notes.append(f"need >= 4 fixtures and 2 hold-outs, found {len(expected) - len(holdout)} and {len(holdout)}")
    for step in (14, 15, 16, 17):
        name, passed = latest_review(step)
        print(f"step {step}: {name or 'no review'} {'VERDICT: PASS' if passed else 'not passed'}")
        ok &= bool(passed)
    if not (STAGE3 / "REPORT.md").is_file():
        ok = False
        notes.append("REPORT.md missing")
    print("attribution to the skill over plain TDD: " + ("supported" if attribution else "unproven"))
    print("\n".join(notes))
    print("STAGE3: PASS" if ok else "STAGE3: FAIL")
    return 0 if ok else 1


def validate():
    """Starter green; hidden tests red on the starter; starter + reference + hidden all green; coverage."""
    ok, metas = True, {}
    for fixture_id, kind in fixtures().items():
        fixture = STAGE3 / kind / fixture_id
        meta = metas[fixture_id] = json.loads((fixture / "meta.json").read_text())
        counts = []
        for overlay, hidden in ((False, False), (False, True), (True, True)):
            tree = WORK / "validate" / fixture_id
            if tree.exists():
                shutil.rmtree(tree)
            shutil.copytree(fixture / "starter", tree)
            if overlay:
                shutil.copytree(fixture / "reference", tree, dirs_exist_ok=True)
            if hidden:
                shutil.copytree(fixture / "hidden", tree / "__acceptance__")
            code, out = sh(["bun", "test", *(["./__acceptance__"] if hidden and not overlay else [])], tree)
            counts.append((code, *bun_counts(out)))
        good = (counts[0][0] == 0 and counts[0][1] > 0 and counts[1][2] > 0
                and counts[2][0] == 0 and counts[2][2] == 0 and counts[2][1] > counts[0][1]
                and meta.get("holdout") == (kind == "holdout") and meta.get("id") == fixture_id
                and all((fixture / part).exists() for part in ("task.md", "starter", "hidden", "reference")))
        ok &= good
        about = "" if kind == "holdout" else f"kind={meta.get('kind')} interacting={meta.get('interacting_modules')} "
        print(f"{kind}/{fixture_id}: {about}starter {counts[0][1]}/{counts[0][2]}  starter+hidden "
              f"{counts[1][1]}/{counts[1][2]}  reference+all {counts[2][1]}/{counts[2][2]}  {'ok' if good else 'BAD'}")
    visible = [m for m in metas.values() if not m.get("holdout")]
    kinds = {m.get("kind") for m in visible}
    interacting = sum(bool(m.get("interacting_modules")) for m in visible)
    holdouts = len(metas) - len(visible)
    covered = kinds >= {"stateful", "parsing", "bugfix", "multi-module"} and interacting >= 2 and holdouts == 2
    print(f"visible kinds {sorted(kinds)}, visible with interacting modules {interacting}, hold-outs {holdouts}"
          f" (hold-out kinds not printed)  {'ok' if covered else 'BAD'}")
    ok &= covered
    print("FIXTURES: OK" if ok else "FIXTURES: BAD")
    return 0 if ok else 1


def main(argv):
    if len(argv) == 4 and argv[0] == "run" and argv[2] in ARMS:
        run(argv[1], argv[2], argv[3])
        return 0
    if len(argv) >= 3 and argv[0] == "batch":
        batch(int(argv[1]), argv[2:])
        return 0
    if len(argv) >= 6 and argv[0] == "review":
        runs = dict(a.split("=", 1) for a in argv[3:] if "=" in a)
        if set(runs) != set(ARMS):
            print("review needs baseline=, canon= and skill=", file=sys.stderr)
            return 2
        review(argv[1], argv[2], runs, "baseline" if "--control" in argv else None)
        return 0
    if argv == ["validate"]:
        return validate()
    if argv[:1] == ["gate"]:
        return gate(argv[argv.index("--phase") + 1] if "--phase" in argv else "main")
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
