{
	"$comment": "Path regex -> layer. First match wins. kind: prod | test | other. Edit and re-run tools/arch-baseline/run.sh. 'exclude' rules drop a path from every metric (listed in the report).",
	"exclude": [
		{ "pattern": "(^|/)(bun\\.lock|bun\\.lockb|package-lock\\.json|yarn\\.lock|pnpm-lock\\.yaml)$", "reason": "lockfile" },
		{ "pattern": "^src/lib/paraglide/", "reason": "generated (Paraglide)" },
		{ "pattern": "(^|/)(dist|build|\\.svelte-kit|coverage|node_modules)/", "reason": "build output" },
		{ "pattern": "(^|/)__snapshots__/|\\.snap$", "reason": "test snapshot" },
		{ "pattern": "^backend/migrations/meta/", "reason": "migration snapshot (drizzle meta)" },
		{ "pattern": "^backend/demo/.*\\.sql$", "reason": "data dump (demo data SQL)" },
		{ "pattern": "^\\.deepcheck-baseline\\.json$|^tools/deepcheck/test/fallow/.*\\.json$", "reason": "generated tool baseline / fixture" },
		{ "pattern": "\\.(png|jpe?g|gif|webp|pdf|woff2?|ttf|otf|ico|zip)$", "reason": "binary (screenshot, font, PDF)" },
		{ "pattern": "^tools/arch-baseline/|^docs/architecture/baseline\\.md$", "reason": "this analysis itself" }
	],
	"layers": [
		{ "pattern": "^backend/src/__tests__/", "layer": "Tests-Unit", "kind": "test" },
		{ "pattern": "(^|/)__tests__/|\\.(test|spec)\\.ts$", "layer": "Tests-Unit", "kind": "test" },
		{ "pattern": "^tests/contracts/", "layer": "Shared/Contracts", "kind": "test" },
		{ "pattern": "^tests/(e2e|a11y|ui-screenshots)/|^tests/exploratory-test\\.ts$|^playwright\\.", "layer": "Tests-Acceptance", "kind": "test" },
		{ "pattern": "^tests/", "layer": "Tests-Unit", "kind": "test" },
		{ "pattern": "^backend/migrations/|^backend/src/db/", "layer": "DB", "kind": "prod" },
		{ "pattern": "^backend/src/", "layer": "Backend", "kind": "prod" },
		{ "pattern": "^backend/CLAUDE\\.md$", "layer": "Process", "kind": "other" },
		{ "pattern": "^backend/", "layer": "Tooling", "kind": "other" },
		{ "pattern": "^src/lib/types\\.ts$", "layer": "Shared/Contracts", "kind": "prod" },
		{ "pattern": "^src/routes/(api|auth)/|^src/lib/server/|^src/hooks\\.server\\.ts$|\\+(page|layout)\\.server\\.ts$|\\+server\\.ts$", "layer": "BFF", "kind": "prod" },
		{ "pattern": "^messages/", "layer": "FE", "kind": "prod" },
		{ "pattern": "^src/|^static/", "layer": "FE", "kind": "prod" },
		{ "pattern": "^docs/reviews/|^docs/archive/|^docs/design/personas/|^implementation_plan\\.md$|CLAUDE\\.md$|^\\.claude/", "layer": "Process", "kind": "other" },
		{ "pattern": "^docs/|\\.md$", "layer": "Docs", "kind": "other" },
		{ "pattern": "^tools/|^\\.github/|^docker|^deploy/|Dockerfile|^[^/]+\\.(json|js|ts|cjs|mjs|yml|yaml|toml)$|^\\.|^project\\.inlang", "layer": "Tooling", "kind": "other" },
		{ "pattern": "^marketing/|^screens/", "layer": "Marketing", "kind": "other" },
		{ "pattern": ".*", "layer": "Other", "kind": "other" }
	],
	"modules": [
		{ "pattern": "^messages/.*", "module": "fe:i18n" },
		{ "pattern": "^src/routes/([^/]+)/.*\\+(page|layout)\\.server\\.ts$", "module": "bff:load/$1" },
		{ "pattern": "^src/routes/api/([^/]+).*", "module": "bff:api/$1" },
		{ "pattern": "^src/routes/auth/.*", "module": "bff:auth" },
		{ "pattern": "^src/lib/server/([^/.]+).*", "module": "bff:server/$1" },
		{ "pattern": "^src/hooks\\.server\\.ts$", "module": "bff:hooks" },
		{ "pattern": "^src/lib/types\\.ts$", "module": "shared:types" },
		{ "pattern": "^src/routes/([^/]+)/.*", "module": "fe:routes/$1" },
		{ "pattern": "^src/routes/[^/]+$", "module": "fe:routes/(root)" },
		{ "pattern": "^src/lib/ui/.*", "module": "fe:ui" },
		{ "pattern": "^src/lib/([^/.]+)\\.(ts|svelte)$", "module": "fe:lib/$1" },
		{ "pattern": "^src/lib/([^/]+)/.*", "module": "fe:lib/$1" },
		{ "pattern": "^src/__tests__/.*", "module": "fe-test:unit" },
		{ "pattern": "^src/.*", "module": "fe:other" },
		{ "pattern": "^backend/src/__tests__/.*", "module": "be-test:unit" },
		{ "pattern": "^backend/src/routes/([^/.]+).*", "module": "be:routes/$1" },
		{ "pattern": "^backend/src/services/([^/.]+?)(\\.service)?\\.ts$", "module": "be:services/$1" },
		{ "pattern": "^backend/src/db/schema\\.ts$", "module": "db:schema" },
		{ "pattern": "^backend/src/db/([^/.]+).*", "module": "db:$1" },
		{ "pattern": "^backend/migrations/.*", "module": "db:migrations" },
		{ "pattern": "^backend/src/([^/.]+)\\.ts$", "module": "be:$1" },
		{ "pattern": "^backend/src/([^/]+)/.*", "module": "be:$1" },
		{ "pattern": "^tests/contracts/.*", "module": "contracts" },
		{ "pattern": "^tests/e2e/([^/]+)/.*", "module": "e2e:$1" },
		{ "pattern": "^tests/([^/]+)/.*", "module": "tests:$1" },
		{ "pattern": "^([^/]+)/([^/]+)/.*", "module": "$1/$2" },
		{ "pattern": "^([^/]+)/.*", "module": "$1" },
		{ "pattern": "^(.*)$", "module": "(root)" }
	],
	"$architectureLayers": "Layers counted as 'Schichten' of production code in M1",
	"architectureLayers": ["FE", "BFF", "Backend", "DB", "Shared/Contracts"],
	"$logicalGroups": "Files that are always edited as one unit by convention; M2 collapses them to one pseudo-file (raw pairs are reported separately)",
	"logicalGroups": [{ "pattern": "^messages/(de|fr|it|en)\\.json$", "name": "messages/{de,fr,it,en}.json" }]
}
