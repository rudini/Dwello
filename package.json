{
	"name": "dwello",
	"version": "0.1.0",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"description": "Swiss Property Management System",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "svelte-kit sync && bddgen && playwright test",
		"test:e2e:wip": "svelte-kit sync && bddgen --tags @wip && playwright test --project=chromium",
		"test:e2e:ui": "svelte-kit sync && bddgen && playwright test --ui",
		"bddgen": "bddgen",
		"check": "bun run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale --silent",
		"prepare": "bun run i18n",
		"type-check": "tsc --noEmit",
		"lint": "eslint . --max-warnings 0 --cache",
		"format": "prettier --write .",
		"deepcheck:scan": "node tools/deepcheck/src/cli.ts scan",
		"deepcheck:audit": "node tools/deepcheck/src/cli.ts check --agent",
		"deepcheck:ci": "node tools/deepcheck/src/cli.ts check --format github --changed-since",
		"deepcheck:baseline": "node tools/deepcheck/src/cli.ts baseline",
		"fitness": "bun tools/fitness/fitness.ts",
		"deps:graph": "ARCH_OUT=build/deps bun tools/arch-baseline/02-imports.ts >/dev/null && ARCH_OUT=build/deps bun tools/arch-baseline/graph.ts | dot -Tsvg -o build/deps/modules.svg && echo build/deps/modules.svg"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@sveltejs/kit": "^2.7.7",
		"jose": "^5.9.6",
		"lucide": "^1.59.0",
		"pdfjs-dist": "6.4.299",
		"svelte": "^5.57.2"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^9.39.5",
		"@inlang/paraglide-js": "2.29.0",
		"@inlang/plugin-message-format": "4.5.4",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^5.2.11",
		"@sveltejs/vite-plugin-svelte": "^5.0.4",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^22.10.5",
		"@types/pngjs": "^6.0.5",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"@vitest/coverage-v8": "^5.0.5",
		"@vitest/ui": "^5.0.5",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.1",
		"fallow": "^3.35.0",
		"fflate": "^0.8.3",
		"globals": "^17.1.0",
		"jsdom": "^30.1.3",
		"playwright-bdd": "^9.2.1",
		"pngjs": "^7.0.0",
		"postcss": "^8.5.30",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte-check": "^4.7.7",
		"svelte-eslint-parser": "^1.9.0",
		"tailwindcss": "^4.3.3",
		"ts-morph": "27.0.2",
		"typescript": "^5.7.3",
		"vite": "^6.4.5",
		"vitest": "^5.0.5"
	},
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"overrides": {
		"cookie": "^0.7.2",
		"postcss-selector-parser": "^7.1.6"
	}
}
