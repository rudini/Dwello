{
  "name": "dwello",
  "version": "0.1.0",
  "private": true,
  "description": "Swiss Property Management System",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:ui": "bddgen && playwright test --ui",
    "bddgen": "bddgen",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@sveltejs/kit": "^2.7.7",
    "date-fns": "^4.1.0",
    "jose": "^5.9.6",
    "leaflet": "^1.9.4",
    "svelte": "^5.2.11",
    "svelte-i18n": "^4.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@sveltejs/adapter-node": "^5.2.11",
    "@sveltejs/vite-plugin-svelte": "^5.0.4",
    "@types/google.maps": "^3.58.1",
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.46.1",
    "fallow": "^2.102.0",
    "globals": "^17.1.0",
    "jsdom": "^27.4.0",
    "playwright-bdd": "^8.4.2",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.2",
    "svelte-check": "^4.1.1",
    "tailwindcss": "^3.4.17",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  }
}
