{
	"name": "dwello",
	"version": "0.1.0",
	"private": true,
	"description": "Swiss Property Management System",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "svelte-kit sync && bddgen && playwright test",
		"test:e2e:wip": "svelte-kit sync && bddgen --tags @wip && playwright test --project=chromium",
		"test:e2e:ui": "svelte-kit sync && bddgen && playwright test --ui",
		"bddgen": "bddgen",
		"check": "bun run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie baseLocale --silent",
		"prepare": "bun run i18n",
		"type-check": "tsc --noEmit",
		"lint": "eslint . --max-warnings 0",
		"format": "prettier --write .",
		"deepcheck:scan": "node tools/deepcheck/src/cli.ts scan",
		"deepcheck:audit": "node tools/deepcheck/src/cli.ts check --agent",
		"deepcheck:ci": "node tools/deepcheck/src/cli.ts check --format github --changed-since",
		"deepcheck:baseline": "node tools/deepcheck/src/cli.ts baseline"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@sveltejs/kit": "^2.7.7",
		"jose": "^5.9.6",
		"lucide": "^1.54.0",
		"pdfjs-dist": "6.3.289",
		"svelte": "^5.57.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^9.39.5",
		"@inlang/paraglide-js": "2.25.4",
		"@inlang/plugin-message-format": "4.4.4",
		"@playwright/test": "^1.49.1",
		"@sveltejs/adapter-node": "^5.2.11",
		"@sveltejs/vite-plugin-svelte": "^5.0.4",
		"@types/node": "^22.10.5",
		"@types/pngjs": "^6.0.5",
		"@typescript-eslint/eslint-plugin": "^8.18.2",
		"@typescript-eslint/parser": "^8.18.2",
		"@vitest/coverage-v8": "^5.0.3",
		"@vitest/ui": "^5.0.3",
		"autoprefixer": "^10.4.20",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.1",
		"fallow": "^2.102.0",
		"globals": "^17.1.0",
		"jsdom": "^27.4.0",
		"playwright-bdd": "^9.2.1",
		"pngjs": "^7.0.0",
		"postcss": "^8.4.49",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.2",
		"svelte-check": "^4.1.1",
		"svelte-eslint-parser": "^0.43.0",
		"tailwindcss": "^3.4.17",
		"ts-morph": "27.0.2",
		"typescript": "^5.7.3",
		"vite": "^6.0.7",
		"vitest": "^5.0.3"
	},
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	}
}
