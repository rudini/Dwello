{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		// Kit 3's generated tsconfig names no $lib: Playwright and Bun resolve it from here (E2E steps import src/lib)
		"paths": { "$lib": ["./src/lib"], "$lib/*": ["./src/lib/*"] }
	},
	"include": [
		".svelte-kit/ambient.d.ts",
		"src/**/*.d.ts",
		"src/**/*.ts",
		"src/**/*.js",
		"src/**/*.svelte",
		"tests/**/*.ts",
		"tools/**/*.ts",
		"*.config.ts"
	],
	"exclude": ["node_modules", "backend"]
}
