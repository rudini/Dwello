{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	"include": [
		".svelte-kit/ambient.d.ts",
		"src/**/*.d.ts",
		"src/**/*.ts",
		"src/**/*.js",
		"src/**/*.svelte",
		"tests/**/*.ts",
		"tools/**/*.ts",
		"*.config.ts"
	],
	"exclude": ["node_modules", "backend"]
}
