# Environment Configuration Example
# Copy this file to .env.local and fill in your actual values

# === Application Settings ===
NODE_ENV=development
PUBLIC_APP_NAME=Dwello
PUBLIC_APP_URL=http://localhost:3000

# === JWT Configuration ===
# Not needed: the installation makes its own key on the first start (docker/init-secrets.sh, #577), and development
# uses a fixed one. An older installation keeps the one it set here.
# JWT_SECRET=
JWT_EXPIRY=7d

# === Access (#51, #576) ===
# Sign-in is with a Konto mit Passwort, created in the backend container: docker exec -it dwello-backend bun run account
# Only when Google is set up below: comma-separated e-mail addresses that may sign in with Google (verified Google
# accounts; Microsoft is then refused), or * for every account. With Google and NODE_ENV=production the frontend refuses
# to start without it
# ALLOWED_EMAILS=

# === OAuth Configuration (optional) ===
# Google OAuth 2.0
# OAUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
# OAUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Microsoft Azure AD OAuth 2.0
# OAUTH_MICROSOFT_CLIENT_ID=your-microsoft-client-id
# OAUTH_MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# OAUTH_MICROSOFT_TENANT_ID=common
# OAUTH_MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/callback

# Swiss eID (future support)
# OAUTH_SWISSEID_CLIENT_ID=
# OAUTH_SWISSEID_CLIENT_SECRET=

# === Database Configuration ===
DATABASE_URL=postgresql://dwello:dwello_password@localhost:5432/dwello
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# === Backend API Configuration ===
BACKEND_URL=http://localhost:3001
BACKEND_API_TIMEOUT=30000   # every backend request except the ones the KI answers (300 s, src/lib/server/api-proxy.ts)

# === E-Mail (Mahnungen) ===
# Versandweg: smtp | resend. Ohne MAIL_TRANSPORT werden Mahnungen an Mieter mit
# Korrespondenzkanal E-Mail nicht versendet, sondern als "zu versenden" abgelegt.
MAIL_TRANSPORT=smtp
MAIL_FROM="Verwaltung Muster <verwaltung@example.ch>"
# SMTP (eigener Mailserver oder Anbieter)
SMTP_HOST=smtp.example.ch
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=verwaltung@example.ch
SMTP_PASSWORD=change-me
# Resend (https://resend.com), statt SMTP: MAIL_TRANSPORT=resend
# RESEND_API_KEY=re_xxx

# === LLM Configuration (any OpenAI-compatible API) ===
# Unset: the local Ollama (http://localhost:11434/v1; in docker-compose.prod.yml http://ollama:11434/v1)
# External provider, e.g. LLM_BASE_URL=https://api.openai.com/v1 with LLM_API_KEY=sk-...
# Invoice data is then sent to that provider: the privacy statement names it, so the backend refuses to start
# without LLM_PROVIDER and LLM_PROVIDER_COUNTRY (see README, "External LLM provider")
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_PROVIDER=OpenAI
# LLM_PROVIDER_COUNTRY=USA
# LLM_MODEL=qwen3-vl:8b-instruct
# LLM_TIMEOUT=120000   # the BFF waits 300 s for the requests the KI answers (two KI calls); above 150 s raise KI_TIMEOUT in src/lib/server/api-proxy.ts
# LLM_ENABLED=false   # turns categorization off

# === Operator of this installation ===
# Named under "Verfügbarkeit" in the terms of use (/terms) and under "Verantwortlich" in the privacy statement;
# without OPERATOR_NAME the operator stays unnamed
# OPERATOR_NAME="Muster Hosting AG"
# OPERATOR_ADDRESS="Bahnhofstrasse 1, 8001 Zürich"
# OPERATOR_CONTACT="betrieb@muster-hosting.ch, 044 123 45 67"
# Named in the privacy statement (/privacy): the country of the server, and with MAIL_TRANSPORT=smtp the provider and
# country of the mail server (both needed). Required when the server or the mail server is outside Switzerland: the
# privacy statement names the country (Art. 19 para. 4 FADP). Choose a provider in a country with adequate data
# protection (Annex 1 DPO), otherwise the privacy statement is incomplete. The values are shown as entered, in all four
# languages.
# OPERATOR_SERVER_COUNTRY=Schweiz
# MAIL_PROVIDER_NAME="Muster Mail AG"
# MAIL_PROVIDER_COUNTRY=Schweiz

# === Swiss QR-Bill Configuration ===
# Property manager's IBAN for QR-bill generation
IBAN=CH93 0076 2011 6238 5295 7
QR_REFERENCE_PREFIX=210000

# === File Storage ===
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=application/pdf,image/jpeg,image/png

# === Feature Flags ===
FEATURE_LLM_CATEGORIZATION=true
FEATURE_EMAIL_NOTIFICATIONS=false
FEATURE_PAYMENT_GATEWAY=false

# === Monitoring & Logging ===
LOG_LEVEL=debug
SENTRY_DSN=

# === Cookie Settings ===
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# === CORS Settings ===
CORS_ORIGIN=http://localhost:3000
